# Revely local environment — DO NOT COMMIT

# --- Database (Neon Postgres; any postgres:// URL works) ---
DATABASE_URL=

# --- Sessions ---
SESSION_SECRET=

# --- OpenAI: reads the label AND analyses the ingredients ---
# As of 2026-08-22 this is the ONLY provider in the label-reading chain, so an
# OpenAI outage is a total scanning outage. See DEFAULT_PROVIDER_CHAIN in
# server/services/labelReader.ts.
OPENAI_API_KEY=
OPENAI_API_KEY_GPT51=

# Comma-separated label-reading chain, tried in order: gemini | openai | ocr.
# Unset means "openai". Set it to restore a fallback WITHOUT a code deploy —
# e.g. "gemini,openai" once the Gemini project has credits again.
LABEL_PROVIDER_CHAIN=

# --- Gemini: NOT in the chain. Its project's prepayment credits are depleted,
# so every call 429s after ~2s. Keys kept so it can be re-enabled via
# LABEL_PROVIDER_CHAIN. AI_INTEGRATIONS_* are the old Replit proxy. ---
GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_API_KEY=
AI_INTEGRATIONS_GEMINI_BASE_URL=

# --- OCR: NOT in the chain. Google Vision + regex heuristics reports no
# declared allergens at all, so it is a fallback that silently drops the
# label's own "contains" line. Still used by the unreferenced /api/ocr route. ---
GOOGLE_CLOUD_VISION_API_KEY=

# --- Resend (feedback emails) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
FEEDBACK_EMAIL=

# --- Stripe (optional; app boots without it) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Client (Vite) ---
VITE_GA_MEASUREMENT_ID=

# --- Server ---
PORT=
# --- Local dev auth (replaces Replit OIDC; see server/localAuth.ts) ---
DEV_USER_ID=
DEV_USER_EMAIL=
ADMIN_USER_ID=
# Enables POST /api/auth/dev-token. Must stay unset in production.
ALLOW_DEV_LOGIN=

# --- Mobile sign-in (see server/mobileAuth.ts) ---
# MUST equal expo.ios.bundleIdentifier in mobile/app.json, currently
# "life.revely.app". Apple ID tokens carry the bundle ID as their audience, so
# a stale value here rejects every Apple sign-in with no clue as to why. It
# held the pre-rename "com.auraly.app" until 2026-08-15.
APPLE_BUNDLE_ID=
# Google sign-in is OFF while these are empty: the server refuses to verify
# tokens, and the app hides the button (see mobile/src/lib/config.ts). To turn
# it on, set both here AND as EXPO_PUBLIC_GOOGLE_* in mobile/eas.json — the
# app needs them at build time, the server at runtime, and they must match.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_WEB_CLIENT_ID=
