# The image is the API server only. Everything below is either the mobile app,
# source material, or something that must never leave the machine.

.git
.gitignore
node_modules
dist

# Secrets. .env is gitignored but Docker does not read .gitignore.
.env
.env.*
!.env.example
# The original Replit secrets export, also gitignored. Docker does not read
# .gitignore, so without this line it went to the builder on every deploy.
secrets.env.txt

# The mobile app is 4.7GB of node_modules and Xcode build output, and the
# server does not import a line of it.
mobile

# Label photos and design source — not read at runtime.
attached_assets
design_handoff_revely
eval

# Local scratch
*.log
.DS_Store

# Claude Code's local settings and worktrees: whole copies of the repo, 78MB
# of the 112MB build context, and nothing the server reads.
.claude
