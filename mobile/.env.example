# Expo client env — only EXPO_PUBLIC_* vars are exposed to the app bundle.
# Server-side secrets belong in the repo-root .env, never here.

# Point the app at a deployed backend. Unset in dev: the app derives the
# LAN IP from the Metro host automatically (see src/lib/config.ts).
EXPO_PUBLIC_API_URL=

# OAuth client IDs from Google Cloud Console (these are not secrets)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
