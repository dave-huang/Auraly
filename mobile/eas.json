{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://revely-api.fly.dev"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://revely-api.fly.dev"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "m-medium"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://revely-api.fly.dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "davehuang01@gmail.com",
        "ascAppId": "6799481205",
        "appleTeamId": "H6R2W747LZ"
      }
    }
  }
}
